#!/bin/bash
# Run from any directory; no virtual-environment activation needed.
set -e
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$project_dir/.venv/bin/python" ]; then
  echo "Set up game-finder first: python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt"
  exit 1
fi
exec "$project_dir/.venv/bin/python" "$project_dir/search_test.py" "$@"
